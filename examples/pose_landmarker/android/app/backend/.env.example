# Local emulator testing can use SQLite:
DATABASE_URL=sqlite+aiosqlite:///./headup-dev.db
# Production / central database should use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://headup:headup_password@localhost:5432/headup
SECRET_KEY=change-this-to-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ADMIN_EMAIL=admin@headup.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SUBSCRIPTION_TIER=admin
# Optional: public URL for a GitHub Release asset or cloud-hosted APK.
# When set, /downloads/headup-debug.apk redirects to this URL.
APK_DOWNLOAD_URL=
