# Production: use a managed PostgreSQL instance. Both postgresql:// and
# postgresql+asyncpg:// are accepted; the backend normalizes the former.
DATABASE_URL=postgresql+asyncpg://headup_user:replace-with-db-password@db.example.com:5432/headup

# Generate a unique random value for every deployment; never commit the real secret.
SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated HTTPS origins allowed to call the API from browsers.
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

ADMIN_EMAIL=admin@headup.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SUBSCRIPTION_TIER=admin

# Optional: public URL for a GitHub Release asset or cloud-hosted APK.
# When set, /downloads/headup-debug.apk redirects to this URL.
APK_DOWNLOAD_URL=

# Local-only alternative:
# DATABASE_URL=sqlite+aiosqlite:///./headup-dev.db
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
