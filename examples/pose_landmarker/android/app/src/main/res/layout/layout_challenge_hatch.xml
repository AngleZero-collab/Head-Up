<?xml version='1.0' encoding='utf-8'?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="16dp" android:background="@drawable/bg_headup_card_strong">

        <TextView android:id="@+id/hatch_kicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_kicker" android:textColor="@color/headup_text_primary" android:textSize="12sp" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/hatch_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_title" android:textColor="@color/headup_text_primary" android:textSize="26sp" android:layout_marginTop="8dp" android:textStyle="bold" />

        <TextView android:id="@+id/demo_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_demo" android:textColor="@color/headup_text_primary" android:textSize="12sp" android:layout_marginTop="8dp" />

        <FrameLayout android:id="@+id/egg_stage" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="12dp">

            <View android:id="@+id/egg_glow" android:layout_width="240dp" android:layout_height="200dp" android:layout_gravity="center" android:background="@drawable/bg_hatch_glow" android:importantForAccessibility="no" />

            <ImageView android:id="@+id/egg_image" android:layout_width="144dp" android:layout_height="180dp" android:layout_gravity="center" android:src="@drawable/ic_hatch_egg" android:contentDescription="@string/hatch_egg_description" />

            <ImageView android:id="@+id/egg_crack" android:layout_width="144dp" android:layout_height="180dp" android:layout_gravity="center" android:src="@drawable/ic_hatch_crack" android:visibility="invisible" android:importantForAccessibility="no" />

        </FrameLayout>

        <TextView android:id="@+id/egg_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_diamond" android:textColor="@color/headup_text_primary" android:textSize="22sp" android:layout_marginTop="8dp" android:gravity="center" android:textStyle="bold" />

        <TextView android:id="@+id/egg_requirement" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_diamond_requirement" android:textColor="@color/headup_text_primary" android:textSize="14sp" android:layout_marginTop="8dp" android:gravity="center" />

        <ProgressBar android:id="@+id/egg_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="16dp" android:max="100" android:progress="68" android:progressDrawable="@drawable/progress_headup" />

        <TextView android:id="@+id/egg_progress_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_diamond_progress" android:textColor="@color/headup_text_primary" android:textSize="12sp" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/egg_rates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_rates_pending" android:textColor="@color/headup_text_primary" android:textSize="14sp" android:layout_marginTop="8dp" />

        <Button android:id="@+id/hatch_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:text="@string/hatch_action" android:textColor="@color/headup_bg_top" android:backgroundTint="@color/headup_primary" />

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none">

            <LinearLayout android:id="@+id/egg_choices" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />

        </HorizontalScrollView>

        <TextView android:id="@+id/hatch_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_hint" android:textColor="@color/headup_text_primary" android:textSize="12sp" android:layout_marginTop="8dp" />

        <LinearLayout android:id="@+id/hatch_result_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp">

            <TextView android:id="@+id/result_badge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_result" android:textColor="@color/headup_text_primary" android:textSize="13sp" android:layout_marginTop="8dp" android:gravity="center" android:accessibilityLiveRegion="polite" />

            <FrameLayout android:layout_width="200dp" android:layout_height="180dp" android:layout_gravity="center" android:background="@drawable/bg_hatch_glow">
                <ImageView android:id="@+id/result_dragon_fallback" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/vision_dragon_sunny_gold_cutout" android:contentDescription="@string/hatch_dragon_description" />
                <com.google.mediapipe.examples.poselandmarker.VisionDragonVideoView android:id="@+id/result_dragon_animation" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:contentDescription="@string/hatch_dragon_description" />
            </FrameLayout>

            <TextView android:id="@+id/result_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_dragon" android:textColor="@color/headup_text_primary" android:textSize="24sp" android:layout_marginTop="8dp" android:gravity="center" android:textStyle="bold" />

            <TextView android:id="@+id/result_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_result_note" android:textColor="@color/headup_text_primary" android:textSize="14sp" android:layout_marginTop="8dp" />

            <Button android:id="@+id/result_story_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:text="@string/hatch_read" android:textColor="@color/headup_bg_top" android:backgroundTint="@color/headup_primary" />

            <Button android:id="@+id/replay_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:text="@string/hatch_replay" android:textColor="@color/headup_bg_top" android:backgroundTint="@color/headup_primary" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="16dp" android:background="@drawable/bg_headup_card_strong">

        <TextView android:id="@+id/story_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_story_title" android:textColor="@color/headup_text_primary" android:textSize="24sp" android:layout_marginTop="8dp" android:textStyle="bold" />

        <TextView android:id="@+id/story_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_story_subtitle" android:textColor="@color/headup_text_primary" android:textSize="14sp" android:layout_marginTop="8dp" />

        <Button android:id="@+id/story_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:text="@string/hatch_story_open" android:textColor="@color/headup_bg_top" android:backgroundTint="@color/headup_primary" />

        <TextView android:id="@+id/growth_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_growth_title" android:textColor="@color/headup_text_primary" android:textSize="18sp" android:layout_marginTop="8dp" android:textStyle="bold" />

        <TextView android:id="@+id/growth_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_growth" android:textColor="@color/headup_text_primary" android:textSize="14sp" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/shiny_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_shiny" android:textColor="@color/headup_text_primary" android:textSize="14sp" android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>