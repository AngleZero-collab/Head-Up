<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_headup_card"
    android:gravity="center_vertical"
    android:minHeight="136dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/stat_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="true"
        android:text="P"
        android:textColor="@color/headup_warning"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="true"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:text="Metric"
        android:textColor="@color/headup_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="true"
        android:maxLines="2"
        android:text="0"
        android:textColor="@color/headup_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />
</LinearLayout>
