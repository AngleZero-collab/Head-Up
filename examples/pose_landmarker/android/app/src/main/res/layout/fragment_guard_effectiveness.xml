<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_headup_icon_button"
                android:contentDescription="@string/back_to_stats"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back_headup" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/guard_effectiveness_title"
                android:textColor="@color/headup_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/range_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:checkedButton="@id/range_7_days"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/range_7_days"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/range_7_days"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/range_30_days"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/range_30_days"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/range_custom"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/range_custom"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/date_range_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/headup_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_headup_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bad_posture_reduction"
                    android:textColor="@color/headup_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/reduction_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--"
                    android:textColor="@color/headup_safe"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_headup_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reminder_correction_rate"
                    android:textColor="@color/headup_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/correction_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--"
                    android:textColor="@color/headup_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/comparison_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_family_notice"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:textColor="@color/headup_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_headup_card"
            android:orientation="vertical"
            android:padding="14dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/unit_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/unit_percent"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/unit_percent"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/unit_percent"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/unit_minutes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/unit_minutes"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/unit_score"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/unit_score"
                    android:textAllCaps="false" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/guard_chart_legend"
                android:textColor="@color/headup_text_secondary"
                android:textSize="12sp" />

            <com.google.mediapipe.examples.poselandmarker.GuardEffectivenessChartView
                android:id="@+id/effectiveness_chart"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/guard_effectiveness_chart_description" />
        </LinearLayout>

        <TextView
            android:id="@+id/day_detail_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_headup_card"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:text="@string/tap_chart_for_details"
            android:textColor="@color/headup_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/recovery_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/headup_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
