<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/monitoring_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/headup_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/monitoring_enabled_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/monitoring_enabled" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/guarding_mode_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/monitoring_guarding_mode" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/monitoring_mode_explanation"
            android:textColor="@color/headup_text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/headup_card_stroke" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/reminder_sound_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/reminder_sound" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/reminder_vibration_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/reminder_vibration" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/reminder_notification_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/reminder_notification" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/inference_frequency"
            android:textColor="@color/headup_text_primary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/inference_frequency_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/inference_3_fps"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="3 FPS" />

            <RadioButton
                android:id="@+id/inference_5_fps"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="5 FPS" />

            <RadioButton
                android:id="@+id/inference_10_fps"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="10 FPS" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
