<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/challenge_title"
            android:textColor="@color/headup_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_headup_card_strong"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/my_vision_dragon"
                    android:textColor="@color/headup_text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/dragon_level_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_headup_reward"
                    android:padding="8dp"
                    android:text="Lv.1"
                    android:textColor="@color/headup_text_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/dragon_trait_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/headup_text_secondary"
                android:textSize="14sp" />

            <com.google.mediapipe.examples.poselandmarker.CircleClipFrameLayout
                android:id="@+id/dragon_orb"
                android:layout_width="188dp"
                android:layout_height="188dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_headup_dragon_orb"
                android:padding="16dp">

                <com.google.mediapipe.examples.poselandmarker.VisionDragonVideoView
                    android:id="@+id/dragon_video_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/vision_dragon_animation"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/dragon_image_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/vision_dragon_animation"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vision_dragon_little_blue_cutout" />

                <ImageView
                    android:id="@+id/dragon_cape_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/equip_dragon"
                    android:paddingTop="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dragon_cape"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/dragon_goggles_overlay"
                    android:layout_width="104dp"
                    android:layout_height="52dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="54dp"
                    android:contentDescription="@string/shop_focus_goggles"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dragon_goggles"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/dragon_armor_overlay"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="42dp"
                    android:contentDescription="@string/shop_starlight_armor"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dragon_armor"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/dragon_badge_overlay"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="18dp"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@string/shop_focus_badge"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dragon_badge"
                    android:visibility="gone" />

            </com.google.mediapipe.examples.poselandmarker.CircleClipFrameLayout>

            <TextView
                android:id="@+id/dragon_name_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/little_blue"
                android:textColor="@color/headup_text_primary"
                android:textSize="28sp" />

            <ProgressBar
                android:id="@+id/dragon_energy_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/progress_headup" />

            <TextView
                android:id="@+id/dragon_energy_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/headup_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/dragon_bond_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/headup_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dragon_mood_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/headup_safe"
                android:textSize="16sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/dragon_selector_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/pet_interactions"
            android:textColor="@color/headup_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/feed_dragon_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/feed_dragon" />

            <Button
                android:id="@+id/play_dragon_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/play_dragon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/rest_dragon_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/rest_dragon" />

            <Button
                android:id="@+id/equip_dragon_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/equip_dragon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_headup_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/maintain_posture_30"
                    android:textColor="@color/headup_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/maintain_task_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/headup_text_secondary" />

                <Button
                    android:id="@+id/claim_maintain_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/claim_reward" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_headup_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protect_eyes"
                    android:textColor="@color/headup_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/protect_task_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:max="3" />

                <TextView
                    android:id="@+id/protect_task_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/headup_text_secondary" />

                <Button
                    android:id="@+id/record_eye_rest_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/record_eye_rest" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
