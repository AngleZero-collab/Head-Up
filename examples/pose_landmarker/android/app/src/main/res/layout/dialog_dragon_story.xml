<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@color/headup_bg_bottom">
    <TextView android:id="@+id/chapter_counter" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_story_subtitle" android:textColor="@color/headup_text_primary" android:textSize="12sp" android:layout_marginTop="8dp" />
    <ScrollView android:id="@+id/story_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
            <TextView android:id="@+id/chapter_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_chapter_0_title" android:textColor="@color/headup_text_primary" android:textSize="24sp" android:layout_marginTop="8dp" android:textStyle="bold" />
            <ImageView android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center" android:src="@drawable/vision_dragon_sunny_gold_cutout" android:importantForAccessibility="no" />
            <TextView android:id="@+id/chapter_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_chapter_0_body" android:textColor="@color/headup_text_primary" android:textSize="17sp" android:layout_marginTop="8dp" android:lineSpacingExtra="6dp" />
            <TextView android:id="@+id/chapter_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_chapter_0_action" android:textColor="@color/headup_text_primary" android:textSize="17sp" android:layout_marginTop="8dp" android:background="@drawable/bg_headup_card_strong" android:padding="16dp" android:lineSpacingExtra="4dp" />
            <TextView android:id="@+id/story_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hatch_source" android:textColor="@color/headup_text_primary" android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/hatch_story_button_text" android:id="@+id/previous_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/hatch_previous" />
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/hatch_story_button_text" android:id="@+id/next_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/hatch_next" />
    </LinearLayout>
    <Button android:id="@+id/close_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:text="@string/hatch_close" android:textColor="@color/headup_bg_top" android:backgroundTint="@color/headup_primary" />
</LinearLayout>