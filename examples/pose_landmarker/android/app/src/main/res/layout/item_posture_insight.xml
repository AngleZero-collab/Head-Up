<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_headup_card"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/insight_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:contentDescription="Insight Icon"
        android:src="@drawable/ic_stats_headup"
        app:tint="@color/headup_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/insight_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/headup_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/insight_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/headup_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
